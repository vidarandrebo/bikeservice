{
    "name": "bikeservice-client",
    "version": "4.2.0",
    "private": true,
    "author": {
        "name": "Vidar André Bø"
    },
    "type": "module",
    "scripts": {
        "dev": "vite",
        "buildDev": "vue-tsc && vite build --mode development",
        "build": "vue-tsc && vite build",
        "preview": "vite preview",
        "lint": "eslint . --report-unused-disable-directives --max-warnings 0",
        "lint-fix": "eslint . --report-unused-disable-directives --max-warnings 0 --fix",
        "format": "prettier . --write",
        "generate": "npm run openapi && npm run lint-fix && npm run format",
        "openapi": "openapi-generator-cli generate -i ../../BikeService.Server.json -g typescript-fetch -o src/Gen/ --additional-properties=withInterfaces=true",
        "test": "vitest run"
    },
    "devDependencies": {
        "@eslint/js": "^10.0.1",
        "@fortawesome/fontawesome-svg-core": "^7.3.1",
        "@fortawesome/free-regular-svg-icons": "^7.3.1",
        "@fortawesome/free-solid-svg-icons": "^7.3.1",
        "@fortawesome/vue-fontawesome": "^3.3.3",
        "@openapitools/openapi-generator-cli": "^2.41.0",
        "@typescript-eslint/eslint-plugin": "^8.70.0",
        "@typescript-eslint/parser": "^8.70.0",
        "@vitejs/plugin-vue": "^6.0.9",
        "buefy": "^3.1.0",
        "bulma": "^1.0.4",
        "eslint": "^10.10.0",
        "eslint-config-prettier": "^10.1.8",
        "eslint-plugin-vue": "^10.11.0",
        "globals": "^17.12.0",
        "prettier": "^3.9.7",
        "sass": "^1.104.1",
        "typescript": "~6.0.3",
        "typescript-eslint": "^8.70.0",
        "vite": "^8.3.0",
        "vitest": "^5.0.1",
        "vue": "^3.5.42",
        "vue-router": "^5.3.1",
        "vue-tsc": "^3.3.11"
    },
    "packageManager": "pnpm@11.10.0"
}
